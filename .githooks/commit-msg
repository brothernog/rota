#!/bin/sh
# Commit message rules (see CONTRIBUTING.md):
# no AI tool attribution lines, and nothing that matches the local deny-list.
msg="$1"
body=$(grep -v '^#' "$msg")

if printf '%s\n' "$body" | grep -i -q -E 'co-authored-by:.*(claude|anthropic|openai|chatgpt|codex|copilot|gemini)|generated (with|by) .*(claude|chatgpt|codex|copilot)|claude\.ai/|chatgpt\.com/'; then
    echo "commit-msg: drop the AI attribution line (disclosure goes in PRs as 'AI-assisted.')" >&2
    exit 1
fi

# Optional, per clone: .git/info/deny-terms, one extended regex per line.
deny=$(git rev-parse --git-path info/deny-terms)
if [ -f "$deny" ]; then
    pats=$(mktemp)
    sed '/^#/d;/^[[:space:]]*$/d' "$deny" > "$pats"
    if printf '%s\n' "$body" | grep -i -q -E -f "$pats"; then
        rm -f "$pats"
        echo "commit-msg: the message matches a term in $deny" >&2
        exit 1
    fi
    rm -f "$pats"
fi
